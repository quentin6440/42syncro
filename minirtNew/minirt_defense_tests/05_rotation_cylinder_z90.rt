# Ambient light
A 0.15 255,255,255

# Camera facing the cylinder
C 0.0,0.0,-10.0 0.0,0.0,1.0 70

# Main light
L -5.0,6.0,-4.0 0.85 255,255,255

# Cylinder rotated 90 degrees around the z axis.
# Its original y-axis direction becomes the x-axis direction.
cy 0.0,0.0,4.0 1.0,0.0,0.0 2.0 6.0 40,100,220
