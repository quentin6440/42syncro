# Ambient light
A 0.15 255,255,255

# Camera located on the z axis and pointing toward the origin
C 0.0,0.0,-10.0 0.0,0.0,1.0 70

# Main light
L -4.0,6.0,-4.0 0.85 255,255,255

# Scene centered around the origin
sp 0.0,0.0,0.0 3.0 220,50,50
pl 0.0,-2.0,0.0 0.0,1.0,0.0 70,120,70
cy -3.0,0.0,5.0 0.0,1.0,0.0 2.0 4.0 50,100,220
