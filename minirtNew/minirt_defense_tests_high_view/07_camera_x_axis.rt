# Ambient light
A 0.15 255,255,255

# Camera on the x axis, elevated and pointing toward the origin
C -12.0,5.0,0.0 0.90,-0.37,0.0 70

# Main light
L -5.0,9.0,-4.0 0.85 255,255,255

# Scene around the origin
sp 0.0,0.0,0.0 3.0 220,50,50
pl 0.0,-2.5,0.0 0.0,1.0,0.0 70,120,70
cy 0.0,1.0,3.0 0.0,1.0,0.0 2.0 4.0 50,100,220
